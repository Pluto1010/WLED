# NPM configuration for WLED build
# Prevent npm from hanging during install

# Use offline mode when possible
prefer-offline=true

# Disable audit to speed up installation
audit=false

# Set reasonable timeout (in milliseconds)
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Retry failed requests up to 3 times
fetch-retries=3

# Use legacy peer deps to avoid conflicts
legacy-peer-deps=true

# Reduce network chatter
progress=false

# Save exact versions to package-lock.json
save-exact=false
